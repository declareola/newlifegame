# Server port
PORT=3000

# JWT signing secret.
# DO NOT ship the placeholder below. Generate one with:  npm run gen-secret
# The server generates one automatically in development, and refuses to
# start in production if this is missing, short, or still a placeholder.
JWT_SECRET=your-super-secret-key-here

# Token lifetime (jsonwebtoken duration string)
JWT_EXPIRES_IN=7d

# Allowed browser origin (the Vite dev server by default)
CLIENT_ORIGIN=http://localhost:5173

# Auth rate limiting
LOGIN_RATE_MAX=20
LOGIN_RATE_WINDOW_MIN=15
SIGNUP_RATE_MAX=5
LOGIN_MAX_FAILURES=5
LOGIN_LOCKOUT_MIN=15

# Blanket limit for every API route (per IP, per minute)
API_RATE_MAX=120
